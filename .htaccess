RewriteEngine On
RewriteRule ^changelog/?$ changelog.php [L,QSA]
RewriteRule ^faq/?$ faq.php [L,QSA]
RewriteRule ^crawl/?$ crawl.php [L,QSA]
RewriteRule ^settings/?$ settings.php [L,QSA]
RewriteRule ^api-docs/?$ api-docs.php [L,QSA]
RewriteRule ^api(/.*)?$ api.php [L,QSA]
RewriteRule ^studios/?$ studios.php [L,QSA]
RewriteRule ^growth/?$ growth.php [L,QSA]
RewriteRule ^forums/?$ forums.php [L,QSA]
RewriteRule ^u/([^/]+)/?$ profile.php?u=$1 [L,QSA]

# Smaller downloads: compress text, let browsers keep images for a month.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

# Private working files written next to script.php (login cookies, log, queue): never served.
<FilesMatch "^scratch-session-">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
